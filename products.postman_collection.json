        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "let jsondata =pm.response.json();\r",
              " pm.test(\"status code is 200\", function()\r",
              "    {\r",
              "         pm.response.to.have.status(200);\r",
              "    }\r",
              ");\r",
              "//pm.test(\"correct board name\", function()\r",
              "//{\r",
              " \r",
              "// pm.expect(jsondata.name).to.eql(\"Menna3\");\r",
              "//});\r",
              "\r",
              "pm.test(\"Board is not closed\", function()\r",
              "{\r",
              "    pm.expect(jsondata.closed).to.eql(false);\r",
              "\r",
              "\r",
              "});\r",
              "\r",
              "pm.test(\"permission level is private\",function()\r",
              "{\r",
              "    pm.expect(jsondata.prefs.permissionLevel).to.eql(\"private\");\r",
              "\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              "//pm.execution.setNextRequest(\"delete board\");\r",
              "\r",
              "pm.environment.set(\"myboardid\", jsondata.id);"
